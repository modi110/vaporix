# Copy to .env.local and fill in. Never commit .env.local.
#
# Every one of these is server-only. The loyalty system's browser code never
# talks to Supabase directly — all reads and writes go through route handlers
# and server actions — so none of these may be renamed to NEXT_PUBLIC_*.

# Project API URL. Supabase dashboard > Project Settings > Data API.
SUPABASE_URL=

# Bypasses row-level security. Server-side only, never logged, never in a
# client component. Supabase dashboard > Project Settings > API Keys >
# service_role (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY=

# Signs the staff session cookie. Any 32+ byte random string; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it logs every staff member out, which is the intended panic button.
LOYALTY_SESSION_SECRET=
